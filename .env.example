APP_NAME="Веб-лаборатория · Лабораторные работы №1–9"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=ru
APP_KEY=
LOG_CHANNEL=stack
LOG_LEVEL=debug
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Локальная база SQLite: MySQL и хостинг не требуются.
DB_CONNECTION=sqlite

# Скрипт setup-local.php создаёт случайный пароль модератора при первом запуске.
# Не используйте настоящую почту и пароль от InfinityFree.
MODERATOR_EMAIL=moderator@example.test
MODERATOR_PASSWORD=

# Для демонстрации лабораторной №8 письмо попадает в storage/logs/laravel.log.
# Настоящая SMTP-отправка по желанию:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mail.ru
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=ВАША_ПОЧТА@mail.ru
# MAIL_PASSWORD=ПАРОЛЬ_ВНЕШНЕГО_ПРИЛОЖЕНИЯ
# MAIL_FROM_ADDRESS=ВАША_ПОЧТА@mail.ru
MAIL_MAILER=log
MAIL_HOST=smtp.mail.ru
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=demo@example.test
MAIL_FROM_NAME="${APP_NAME}"
