APP_NAME="Веб-лаборатория"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
LOG_CHANNEL=stack
LOG_LEVEL=debug
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
DB_CONNECTION=sqlite

MODERATOR_EMAIL=moderator@example.test
MODERATOR_PASSWORD=

# Настройки отправки писем
MAIL_MAILER=smtp
MAIL_HOST=smtp.mail.ru
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=test@mospolytech.ru
MAIL_FROM_NAME="${APP_NAME}"
